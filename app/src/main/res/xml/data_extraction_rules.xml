<?xml version="1.0" encoding="utf-8"?>
<!--
  Offline / privacy posture: exclude all vault data from cloud backup and
  device-transfer. Nothing leaves the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
